# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)
# บน Vercel: ใส่ค่าพวกนี้ที่ Project Settings > Environment Variables แทน

# --- LINE Messaging API ---
LINE_CHANNEL_ACCESS_TOKEN=
# ใส่ก็ได้ (แนะนำ) เพื่อตรวจว่าข้อความมาจาก LINE จริง — ไม่ใส่ก็ยังทำงานได้
LINE_CHANNEL_SECRET=

# --- OpenRouter (AI vision อ่านสลิป) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
