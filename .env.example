# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)
# บน Vercel: ใส่ค่าพวกนี้ที่ Project Settings > Environment Variables แทน

# --- LINE Messaging API ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# จำกัดให้ทำงานเฉพาะกลุ่มร้าน (groupId ได้จาก log ครั้งแรกที่บอทเข้ากลุ่ม) เว้นว่าง = รับทุกกลุ่ม
ALLOWED_GROUP_ID=

# --- OpenRouter (AI vision อ่านสลิป) ---
OPENROUTER_API_KEY=
# โมเดล vision ที่รองรับรูป (เปลี่ยนได้)
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# --- Google Sheets (ที่เก็บข้อมูล) ---
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# วาง private key ทั้งก้อน (ขึ้นบรรทัดใหม่แทนด้วย \n)
GOOGLE_PRIVATE_KEY=

# นานแค่ไหนที่สลิปที่ส่งก่อนหน้า ยังนับรวมกับข้อความ #ตรวจเงิน (นาที)
PENDING_WINDOW_MIN=45
